# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Local dev uses SQLite. Production must use PostgreSQL, e.g.:
# DATABASE_URL=postgresql+asyncpg://restroos_app:change-me@localhost:5432/restroos
DATABASE_URL=sqlite+aiosqlite:///./restroos.db

# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-please-use-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Comma-separated exact origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure cookies must be true in production (HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Auth rate limiting (per IP + route, per minute). Use Redis in production.
AUTH_RATE_LIMIT_PER_MINUTE=20

# Plan limits are seeded from app/modules/billing/service.py
FREE_PLAN_MAX_RESTAURANTS=1
FREE_PLAN_MAX_STAFF=5

# Optional: enables tests/isolation/test_postgres_rls.py against a migrated
# PostgreSQL database. Use the low-privilege runtime role, never the owner.
# TEST_POSTGRES_URL=postgresql+asyncpg://restroos_app:restroos_app_dev_password@localhost:5432/restroos
